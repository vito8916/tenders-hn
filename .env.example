# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key

# Base URL of the app, used to build absolute links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Resend (https://resend.com) - used to send organization invitation emails
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Multi-Tenant SupaNext Kit <onboarding@resend.dev>"

# Service role, used only by the Paddle webhook (lib/supabase/admin.ts). Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Paddle (plan §7.5). "sandbox" for local and staging, "production" live.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
# endpoint_secret_key of the notification destination that points at /api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
