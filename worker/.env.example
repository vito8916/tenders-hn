# Direct Postgres connection used for queues and SQL.
# Local stack (pnpm db:start). In Supabase Cloud use the session pooler or direct connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Vercel AI Gateway key (needed by AI jobs and `pnpm --filter worker ai:smoke`).
AI_GATEWAY_API_KEY=

# Optional per-role model overrides, e.g. AI_MODEL_CHAT=openai/gpt-6-luna
# AI_MODEL_EVALUATE=
# AI_MODEL_CHAT=
# AI_MODEL_EMBED=
